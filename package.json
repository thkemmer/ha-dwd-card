{
  "name": "ha-dwd-card",
  "version": "1.2.0",
  "type": "module",
  "description": "A custom Home Assistant card for DWD Weather Warnings",
  "main": "dist/ha-dwd-card.js",
  "scripts": {
    "build": "rollup -c",
    "build:dev": "DEV=true rollup -c",
    "watch": "rollup -c -w",
    "watch:dev": "DEV=true rollup -c -w",
    "test": "NODE_OPTIONS='--no-deprecation' vitest run",
    "test:coverage": "NODE_OPTIONS='--no-deprecation' vitest run --coverage",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "rm -rf dist coverage",
    "start": "echo 'Local preview: http://localhost:8000/demo/' && python3 -m http.server 8000"
  },
  "author": "Mact",
  "license": "MIT",
  "dependencies": {
    "custom-card-helpers": "^2.0.0",
    "lit": "^3.1.0"
  },
  "devDependencies": {
    "@open-wc/testing": "^4.0.0",
    "@rollup/plugin-json": "^6.1.0",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-replace": "^6.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@rollup/plugin-typescript": "^12.3.0",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitest/coverage-v8": "^4.0.18",
    "eslint": "^10.3.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-lit": "^2.1.1",
    "eslint-plugin-wc": "^3.0.2",
    "globals": "^17.0.0",
    "home-assistant-js-websocket": "^9.1.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.7.4",
    "rollup": "^4.9.6",
    "tslib": "^2.6.2",
    "typescript": "^6.0.3",
    "vitest": "^4.0.16"
  }
}
